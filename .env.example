PORT=5000
MONGODB_URI=mongodb://localhost:27017/hanoigo
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_DAYS=30
CORS_ORIGIN=http://localhost:5173
OTP_RESEND_COOLDOWN_SECONDS=60

# Google OAuth client used to verify Google ID tokens from the frontend.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=

# Cloudinary image storage. Prefer CLOUDINARY_URL or provide the three explicit values.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMTP config is required for OTP email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="HanoiGo <no-reply@hanoigo.local>"
SMTP_ALLOW_OTP_LOGGING=false

# Optional Gemini integration. Without this key, itinerary generation uses fallback logic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_STRICT=false
